# Variables de entorno del backend de cuentas (api/). Cargarlas en Vercel →
# Settings → Environment Variables. NUNCA commitear un .env con valores reales
# (.env* está en .gitignore) ni exponer estas claves en el front (VITE_*).
TURSO_DATABASE_URL=libsql://finanzar-<org>.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=<token creado con `turso db tokens create finanzar` o desde el dashboard>
